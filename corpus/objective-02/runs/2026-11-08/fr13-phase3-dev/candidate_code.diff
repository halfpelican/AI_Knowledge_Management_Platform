+# --- The batch embedding: one call, validated as a batch ---------------------------------
+
+
+class CountedService:
+    """Returns ``vector_count`` vectors whatever was asked, to exercise the usability check."""
+
+    def __init__(self, vector_count):
+        self.vector_count = vector_count
+        self.embed_calls: list[list[str]] = []
+
+    def embed(self, texts):
+        self.embed_calls.append(list(texts))
+        return EmbeddingResult(
+            vectors=[wide(1.0) for _ in range(self.vector_count)],
+            model=STUB_EMBEDDING_MODEL,
+            dimension=settings.EMBEDDING_DIMENSION,
+        )
+
+    def generate_statements(self, question, passages):  # pragma: no cover - never called
+        raise AssertionError("not called")
+
+    def health(self):  # pragma: no cover - never called
+        raise AssertionError("not called")
+
+
+def test_embed_query_texts_returns_one_vector_per_text(monkeypatch):
+    service = CountedService(vector_count=2)
+    monkeypatch.setattr(apps.ai, "get_ai_service", lambda: service)
+
+    result = embed_query_texts([FIRST, FOLLOW_UP])
+
+    assert len(result.vectors) == 2
+    assert service.embed_calls == [[query_text(FIRST), query_text(FOLLOW_UP)]]
+
+
+def test_embed_query_texts_refuses_a_count_that_does_not_match(monkeypatch):
+    """The failure path: one vector for two texts is a misconfigured provider, not a retry."""
+    service = CountedService(vector_count=1)
+    monkeypatch.setattr(apps.ai, "get_ai_service", lambda: service)
+
+    with pytest.raises(ProviderUnavailable):
+        embed_query_texts([FIRST, FOLLOW_UP])
+    # Not retried: three identical wrong answers are the same wrong answer three times.
+    assert len(service.embed_calls) == 1
