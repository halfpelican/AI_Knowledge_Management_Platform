--- /dev/null
+++ b/apps/retrieval/tests/test_follow_up_focus.py
@@ -0,0 +1,359 @@
+"""Step 7 phase 3 (FR-13): a follow-up answers the question actually asked.
+
+The 3 November thread run (corpus/objective-02/runs/2026-11-03/fr13-before.md) measured
+two failures in one symptom: 7 of 9 answered with-history follow-ups restated the FIRST
+turn's answer. Phase 3 is two changes, and this module tests each at its boundary,
+because each is only safe inside it:
+
+1. **Option 1, the prompt.** The conversational block now says the earlier questions are
+   not to be answered again, and the lead-in says the question below is the only one to
+   answer. The boundary is BYTE-IDENTITY for a single-turn prompt: with no history the
+   composed prompt is exactly the question, so docs/flm-baseline.md and every frozen
+   single-question measurement keep describing the one-off path. SYSTEM_PROMPT is
+   untouched.
+
+2. **Option 2, retrieval.** A turn with history embeds TWO texts in ONE ``embed()`` call
+   — the composed join and the follow-up on its own — and each candidate's score is the
+   LARGER of its two cosines (``rank_by_best``). The boundary is invariant 1: both
+   vectors are scored over the SAME already-scoped candidate set, so the second text can
+   change which in-scope passage wins and cannot widen what exists to be scored. A
+   single-turn call embeds one text and the maximum is the identity.
+
+The measuring-tools half of the change — the harness and the HTTP check computing
+retrieval through the shipped functions — is pinned in
+apps/ai/tests/test_fr13_measurement_scripts.py, beside the other script tests.
+"""
+
+from math import sqrt
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+from django.conf import settings
+
+import apps.ai
+from apps.ai.base import EmbeddingResult, Passage, ProviderUnavailable, Statement, StatementList
+from apps.ai.prefixes import query_text
+from apps.ai.prompting import (
+    PRIOR_QUESTIONS_HEADING,
+    QUESTION_LEAD_IN,
+    build_conversational_question,
+    build_user_prompt,
+)
+from apps.ai.testing import STUB_EMBEDDING_MODEL
+from apps.core.constants import (
+    ADMINISTRATOR_ROLE_NAME,
+    EMPLOYEE_ROLE_NAME,
+    NO_RELEVANT_PASSAGE,
+    RELEVANCE_THRESHOLD,
+    SOURCE_TYPES,
+)
+from apps.documents.models import ContentChunk
+from apps.retrieval.conversation import RETRIEVAL_JOIN, compose
+from apps.retrieval.models import Conversation, QueryLog
+from apps.retrieval.pipeline import answer_question
+from apps.retrieval.query_embedding import embed_query_texts
+from apps.retrieval.ranking import rank, rank_by_best
+
+FIRST = "Which company handles our catering?"
+FOLLOW_UP = "How do I order lunch from them?"
+ONE_OFF = "What is the catering budget for staff events?"
+
+# The two fragments option 1 added, asserted as content rather than only through the
+# constants, so reverting the wording fails here even if the constants stay imported.
+HEADING_FOCUS_FRAGMENT = "do not restate facts that answer them"
+LEAD_IN_FOCUS_FRAGMENT = "the only question to answer"
+
+
+def wide(*components) -> list[float]:
+    """The given leading components, zero-padded to the real column width."""
+    values = list(components)
+    return values + [0.0] * (settings.EMBEDDING_DIMENSION - len(values))
+
+
+# Two orthogonal unit query vectors: every expected cosine below is readable by eye.
+JOIN_VECTOR = wide(1.0)  # what the composed join embeds to, in these tests
+FOLLOW_UP_VECTOR = wide(0.0, 1.0)  # what the follow-up alone embeds to
+
+ABOVE = 0.80
+assert RELEVANCE_THRESHOLD < ABOVE
+
+
+class TwoVectorService:
+    """An AIService whose query vectors depend on the text, so the two texts differ.
+
+    ``vector_by_text`` maps the PREFIXED text (what the provider actually receives,
+    apps/ai/prefixes.py) to its vector. Generation cites the first passage, which is how
+    the tests below read "which passage won the ranking" off the answer.
+    """
+
+    def __init__(self, vector_by_text):
+        self.vector_by_text = dict(vector_by_text)
+        self.embed_calls: list[list[str]] = []
+        self.generate_calls: list[tuple] = []
+
+    def embed(self, texts):
+        self.embed_calls.append(list(texts))
+        return EmbeddingResult(
+            vectors=[list(self.vector_by_text[text]) for text in texts],
+            model=STUB_EMBEDDING_MODEL,
+            dimension=settings.EMBEDDING_DIMENSION,
+        )
+
+    def generate_statements(self, question, passages):
+        self.generate_calls.append((question, list(passages)))
+        return StatementList(
+            statements=[Statement(text="A grounded statement.", chunk_id=passages[0].chunk_id)]
+        )
+
+    def health(self):
+        raise AssertionError("the pipeline does not check provider health")
+
+
+def make_chunk(document, visible_to_roles, *, index, embedding, text="A passage."):
+    return ContentChunk.objects.create(
+        source_type=SOURCE_TYPES[0],
+        source_id=document.id,
+        chunk_index=index,
+        chunk_text=text,
+        embedding=embedding,
+        embedding_model=STUB_EMBEDDING_MODEL,
+        embedding_dimension=settings.EMBEDDING_DIMENSION,
+        visible_to_roles=visible_to_roles,
+    )
+
+
+def make_history(employee):
+    """A conversation with FIRST already asked, so the next ask is a with-history turn."""
+    conversation = Conversation.objects.create(user=employee, title="Catering")
+    QueryLog.objects.create(
+        user=employee,
+        conversation=conversation,
+        question=FIRST,
+        answer_text=None,
+        retrieved_chunk_ids=[],
+        answered=False,
+        no_answer_reason=NO_RELEVANT_PASSAGE,
+        rejected_count=None,
+    )
+    return conversation
+
+
+def follow_up_service():
+    """The double for a with-history turn: the join and the follow-up embed differently."""
+    joined = RETRIEVAL_JOIN.join([FIRST, FOLLOW_UP])
+    return TwoVectorService(
+        {
+            query_text(joined): JOIN_VECTOR,
+            query_text(FOLLOW_UP): FOLLOW_UP_VECTOR,
+        }
+    )
+
+
+# --- Option 1: the instruction exists only inside the conversational block --------------
+
+
+def test_a_single_turn_prompt_is_byte_identical_to_the_question():
+    """The boundary that keeps every frozen single-question measurement valid.
+
+    With no history the composed prompt IS the question — not the question plus a new
+    instruction — and the full user prompt carries no trace of the conversational block.
+    """
+    assert build_conversational_question(ONE_OFF, []) == ONE_OFF
+    assert compose(ONE_OFF, []).for_prompt == ONE_OFF
+
+    prompt = build_user_prompt(ONE_OFF, [Passage(chunk_id=str(uuid4()), text="A passage.")])
+    assert PRIOR_QUESTIONS_HEADING not in prompt
+    assert QUESTION_LEAD_IN not in prompt
+    assert HEADING_FOCUS_FRAGMENT not in prompt
+    assert LEAD_IN_FOCUS_FRAGMENT not in prompt
+
+
+def test_the_focus_instruction_is_present_exactly_when_there_is_history():
+    """Option 1's words are in the block — and only in the block.
+
+    Asserted as text, not only through the constants: a revert of the wording that kept
+    the constants' names would still fail here.
+    """
+    assert HEADING_FOCUS_FRAGMENT in PRIOR_QUESTIONS_HEADING
+    assert LEAD_IN_FOCUS_FRAGMENT in QUESTION_LEAD_IN
+
+    composed = build_conversational_question(FOLLOW_UP, [FIRST])
+    assert PRIOR_QUESTIONS_HEADING in composed
+    assert composed.endswith(f"{QUESTION_LEAD_IN}{FOLLOW_UP}")
+    assert HEADING_FOCUS_FRAGMENT in composed
+    assert LEAD_IN_FOCUS_FRAGMENT in composed
+
+
+# --- Option 2: rank_by_best, the maximum per candidate ----------------------------------
+
+
+def stand_in(embedding):
+    """A candidate for rank(): ranking reads attributes, so no row is needed."""
+    return SimpleNamespace(
+        id=uuid4(),
+        chunk_text="A passage.",
+        embedding=embedding,
+        source_type=SOURCE_TYPES[0],
+        source_id=uuid4(),
+    )
+
+
+def test_rank_by_best_takes_each_candidates_larger_score_in_both_directions():
+    """One candidate wins on the composed vector, the other on the follow-up's.
+
+    near_join: cosine 0.9 against JOIN_VECTOR and 0.0 against FOLLOW_UP_VECTOR — the
+    composed score wins. near_follow_up: 0.2 against JOIN_VECTOR and ~0.98 against
+    FOLLOW_UP_VECTOR — the follow-up's score wins, and wins the ordering, which is the
+    3 November failure inverted: the follow-up's own wording gets a vote.
+    """
+    near_join = stand_in(wide(0.9, 0.0, sqrt(1 - 0.81)))
+    near_follow_up = stand_in(wide(0.2, sqrt(1 - 0.04)))
+
+    ranked = rank_by_best([near_join, near_follow_up], [JOIN_VECTOR, FOLLOW_UP_VECTOR])
+
+    assert [passage.chunk_id for passage in ranked] == [
+        str(near_follow_up.id),
+        str(near_join.id),
+    ]
+    assert ranked[0].score == pytest.approx(sqrt(1 - 0.04))  # the follow-up's cosine won
+    assert ranked[1].score == pytest.approx(0.9)  # the composed cosine won
+
+
+def test_rank_of_one_vector_is_rank_by_best_of_exactly_it():
+    """Single-turn retrieval is unchanged: one vector, the same scores, the same order."""
+    candidates = [stand_in(wide(0.5, sqrt(1 - 0.25))), stand_in(wide(0.9, sqrt(1 - 0.81)))]
+
+    assert rank(candidates, JOIN_VECTOR) == rank_by_best(candidates, [JOIN_VECTOR])
+
+
+def test_rank_by_best_refuses_no_vectors():
+    with pytest.raises(ValueError):
+        rank_by_best([stand_in(wide(1.0))], [])
+
+
+# --- Option 2 in the pipeline: one embed call, scope before ranking ----------------------
+
+
+@pytest.mark.django_db
+def test_a_follow_up_embeds_both_texts_in_one_call(document, monkeypatch):
+    """One ``embed()`` call carries the join AND the follow-up, prefixed, in that order."""
+    employee = document.uploaded_by
+    make_chunk(document, [EMPLOYEE_ROLE_NAME], index=1, embedding=wide(ABOVE, sqrt(1 - ABOVE**2)))
+    service = follow_up_service()
+    monkeypatch.setattr(apps.ai, "get_ai_service", lambda: service)
+    conversation = make_history(employee)
+
+    answer_question(question=FOLLOW_UP, user=employee, conversation=conversation)
+
+    assert service.embed_calls == [
+        [query_text(RETRIEVAL_JOIN.join([FIRST, FOLLOW_UP])), query_text(FOLLOW_UP)]
+    ]
+
+
+@pytest.mark.django_db
+def test_the_follow_ups_own_score_can_win_the_ranking(document, monkeypatch):
+    """End to end: the passage nearest the follow-up outranks the one nearest the join."""
+    employee = document.uploaded_by
+    near_join = make_chunk(
+        document, [EMPLOYEE_ROLE_NAME], index=1,
+        embedding=wide(0.5, 0.0, sqrt(1 - 0.25)), text="The catering contract."
+    )
+    near_follow_up = make_chunk(
+        document, [EMPLOYEE_ROLE_NAME], index=2,
+        embedding=wide(0.0, 0.9, 0.0, sqrt(1 - 0.81)), text="Orders go to book@ridgeline.example."
+    )
+    service = follow_up_service()
+    monkeypatch.setattr(apps.ai, "get_ai_service", lambda: service)
+    conversation = make_history(employee)
+
+    outcome = answer_question(question=FOLLOW_UP, user=employee, conversation=conversation)
+
+    assert outcome.answered
+    # Best of the two cosines per candidate: 0.9 (follow-up) beats 0.5 (join).
+    assert [passage.chunk_id for passage in outcome.passages] == [
+        str(near_follow_up.id),
+        str(near_join.id),
+    ]
+    assert outcome.verified_statements[0].chunk_id == str(near_follow_up.id)
+
+
+@pytest.mark.django_db
+def test_the_scope_still_filters_before_ranking_whichever_vector_is_nearest(
+    document, monkeypatch
+):
+    """Invariant 1 under phase 3: the follow-up's vector cannot reach an out-of-scope row.
+
+    The Administrator-only chunk is the NEAREST candidate to the follow-up's own vector —
+    cosine 0.99, far above everything else — so a post-filter shape, or a second
+    candidate set built for the second vector, would rank it first and cite it. It must
+    appear nowhere: not in the passages, not in the prompt, not in the statements.
+    """
+    employee = document.uploaded_by
+    readable = make_chunk(
+        document, [EMPLOYEE_ROLE_NAME], index=1,
+        embedding=wide(ABOVE, sqrt(1 - ABOVE**2)), text="The catering contract."
+    )
+    restricted = make_chunk(
+        document, [ADMINISTRATOR_ROLE_NAME], index=2,
+        embedding=wide(0.0, 0.99, sqrt(1 - 0.99**2)), text="Supplier margins, restricted."
+    )
+    service = follow_up_service()
+    monkeypatch.setattr(apps.ai, "get_ai_service", lambda: service)
+    conversation = make_history(employee)
+
+    outcome = answer_question(question=FOLLOW_UP, user=employee, conversation=conversation)
+
+    assert outcome.answered
+    assert [passage.chunk_id for passage in outcome.passages] == [str(readable.id)]
+    supplied = [
+        passage.chunk_id for _, passages in service.generate_calls for passage in passages
+    ]
+    assert str(restricted.id) not in supplied
+    assert all(statement.chunk_id == str(readable.id) for statement in outcome.verified_statements)
+
