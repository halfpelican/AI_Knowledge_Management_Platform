+# This copy: Claude's token usage, for the spend report. The wrapper records the counts each
+# reply carries and returns the reply unchanged; a call that raised cost nothing to count.
+from apps.ai.anthropic import AnthropicService  # noqa: E402
+
+CLAUDE_USAGE = {"calls": 0, "input_tokens": 0, "output_tokens": 0, "calls_without_counts": 0}
+_original_claude_once = AnthropicService._claude_once
+
+
+def _counting_claude_once(self, *args, **kwargs):
+    reply = _original_claude_once(self, *args, **kwargs)
+    CLAUDE_USAGE["calls"] += 1
+    if reply.prompt_tokens is None or reply.completion_tokens is None:
+        CLAUDE_USAGE["calls_without_counts"] += 1
+    CLAUDE_USAGE["input_tokens"] += reply.prompt_tokens or 0
+    CLAUDE_USAGE["output_tokens"] += reply.completion_tokens or 0
+    return reply
+
+
+AnthropicService._claude_once = _counting_claude_once
+
+
+def usage_record() -> dict:
+    """The tally, with an estimate at D-115's prices. The Console's figure governs."""
+    estimate = (CLAUDE_USAGE["input_tokens"] * SONNET_PRICE_PER_MILLION["input"]
+                + CLAUDE_USAGE["output_tokens"] * SONNET_PRICE_PER_MILLION["output"]) / 1_000_000
+    return {**CLAUDE_USAGE, "estimated_usd": round(estimate, 4),
+            "prices_per_million_usd": dict(SONNET_PRICE_PER_MILLION)}
+
+
+def print_usage() -> None:
+    usage = usage_record()
+    print(f"Claude usage    : {usage['calls']} call(s), {usage['input_tokens']} input and "
+          f"{usage['output_tokens']} output tokens, about US${usage['estimated_usd']:.4f} "
+          f"at D-115's prices ({usage['calls_without_counts']} call(s) without counts)")
+
+
