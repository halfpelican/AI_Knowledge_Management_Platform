title Schema v2 (Area 3 of 4) — Meetings: 4 tables, 9 foreign keys

entity "users" as users <<ref>> {
  * user_id : uuid <<PK>>
}

package "Meetings · FR-09, FR-11, FR-16" as meetings_pkg #EEF6EE {
  entity "meetings" as meetings {
    * meeting_id : uuid <<PK>>
    --
    * status : varchar
    * visible_to_roles : text[]
  }

  entity "meeting_summaries" as meeting_summaries <<added>> {
    * summary_id : uuid <<PK>>
    --
    * meeting_id : uuid <<FK>>
    requested_by : uuid <<FK>>
    * run_number : int
    * status : varchar
    * model : varchar
    * queued_for_retry : bool
  }

  entity "meeting_attendees" as meeting_attendees {
    * attendee_id : uuid <<PK>>
    --
    * meeting_id : uuid <<FK>>
    * user_id : uuid <<FK>>
  }

  entity "action_items" as action_items <<added>> {
    * action_item_id : uuid <<PK>>
    --
    * meeting_id : uuid <<FK>>
    summary_id : uuid <<FK>>
    owner_id : uuid <<FK>>
    created_by : uuid <<FK>>
    updated_by : uuid <<FK>>
    * origin : varchar
    * edited : bool
  }
}

meetings ||--o{ meeting_summaries : "meeting_id"
meetings ||--o{ meeting_attendees : "meeting_id"
meetings ||--o{ action_items : "meeting_id"
meeting_summaries |o--o{ action_items : "summary_id"
users ||--o{ meeting_attendees : "user_id"
users |o--o{ meeting_summaries : "requested_by"
users |o--o{ action_items : "owner_id"
users |o--o{ action_items : "created_by"
users |o--o{ action_items : "updated_by"

' Keep meeting_summaries on the left above action_items, and meeting_attendees on the right beside users
meeting_summaries -[hidden]right- meeting_attendees

note bottom of action_items
  **Role-scoped meetings & FR-16 summaries (D-16, D-125)**
  meetings.visible_to_roles mirrors documents and cascades to content_chunks (Area 2);
  meeting_attendees is a participation record (FR-16 owner matching, FR-20 map), never an access rule.
  meeting_summaries is unique on (meeting_id, run_number); Ready summaries are indexed in
  content_chunks with ai_generated = true. action_items belong to the meeting so edits outlive Regenerate.
end note

