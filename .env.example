# Copy this file to .env and adjust. .env is gitignored and must never be committed.
# Every variable here is read by config/settings.py through django-environ.
# Comments must sit on their own line; an inline "# ..." becomes part of the value.

# --- Django ---------------------------------------------------------------
# SECRET_KEY and DATABASE_URL have no default: the process refuses to start without them.
SECRET_KEY=change-me-dev-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# The alpha's deployment settings (D-64, docs/alpha-deployment.md). Each defaults to the
# loopback value shown, so none needs setting on the laptop. Serving over HTTPS later means
# setting the origin and turning both cookie flags on, under a new decision.
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# The production build of frontend/ that the server serves. Absolute; default frontend/dist.
# SPA_DIST_DIR=

# PostgreSQL 16 + pgvector from docker-compose.yml. Development credentials only.
DATABASE_URL=postgres://kmp:kmp@127.0.0.1:5432/kmp

# Where uploaded originals are stored (FR-08, docs/decisions.md D-05). Relative
# paths resolve against the process working directory; media/ under the repository
# root is the default and is gitignored. The extracted text is stored in the
# database, separately from the original.
MEDIA_ROOT=media

# --- AI provider (CLAUDE.md section 4, docs/ai-provider.md) ----------------
# anthropic Claude + Voyage. The default since D-122: needs the two API keys below, no NPU.
# flm       FastFlowLM on the local NPU. The offline alternative, v0.9.39 only (D-83).
# The two embed at different widths, so a database is indexed for one of them. Switching is a
# full re-index:  python manage.py reindex --provider <name> --resize-column <database name>
AI_PROVIDER=anthropic

# Anthropic + Voyage, the default. Each key comes from its own console; never commit them.
# voyage-4 embeds at 1024 dimensions, so EMBEDDING_DIMENSION below must be 1024 and the
# database's vector column that wide. A database built at FLM's 768 is resized by
#   python manage.py reindex --provider anthropic --resize-column <database name>
# which deletes and rebuilds every chunk (docs/decisions.md D-117).
ANTHROPIC_API_KEY=
# Generation and FR-10 classification (D-121). claude-sonnet-5-5 is D-115's model.
ANTHROPIC_MODEL=claude-haiku-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# FastFlowLM, only read when AI_PROVIDER=flm. Start it in a second PowerShell window:
#   flm serve gemma3:4b --embed 1
FLM_BASE_URL=http://127.0.0.1:8625/v1
FLM_API_KEY=flm
FLM_CHAT_MODEL=gemma3:4b
FLM_EMBED_MODEL=embed-gemma

# Recording transcription (docs/decisions.md D-123): the meetings page turns a meeting
# recording into a draft transcript with Whisper on FLM. Independent of AI_PROVIDER, because only
# FLM has speech-to-text. none (the default) leaves it off; flm needs FLM started with --asr 1:
#   flm serve gemma3:4b --embed 1 --asr 1
TRANSCRIPTION_PROVIDER=none

# Where a meeting summary's run happens (FR-16, D-125). "thread", the default, runs it in a
# background thread of the server after the request has answered 202; the stack has no task queue.
# "inline" runs it in the caller's thread and is for the test suite. Leave it unset on a server.
# SUMMARY_RUNNER=thread
FLM_ASR_MODEL=whisper-v3:turbo

# Must equal the length of the vectors the embedding model returns (docs/decisions.md D-03):
# 1024 for voyage-4, 768 for embed-gemma. Changing it is a full re-index event.
EMBEDDING_DIMENSION=1024
