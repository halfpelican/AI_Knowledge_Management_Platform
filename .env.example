# Copy this file to .env and adjust. .env is gitignored and must never be committed.
# Every variable here is read by config/settings.py through django-environ.
# Comments must sit on their own line; an inline "# ..." becomes part of the value.

# --- Django ---------------------------------------------------------------
# SECRET_KEY and DATABASE_URL have no default: the process refuses to start without them.
SECRET_KEY=change-me-dev-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# The alpha's deployment settings (D-64, docs/alpha-deployment.md). Each defaults to the
# loopback value shown, so none needs setting on the laptop. Serving over HTTPS later means
# setting the origin and turning both cookie flags on, under a new decision.
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# The production build of frontend/ that the server serves. Absolute; default frontend/dist.
# SPA_DIST_DIR=

# FR-03's lockout policy (D-130 decision 7). Each defaults to the value shown, so neither needs
# setting. LoginView reads them, and the sign-in page fetches them from /api/auth/lockout-policy,
# so a change needs a server restart but no front-end rebuild. The policy may only be tightened
# (FR-03, NFR-04; D-130 decision 8): LOCKOUT_THRESHOLD from 1 to 5, LOCKOUT_DURATION_MINUTES from
# 15 to 525600 (365 days). Any other value stops the server starting.
# LOCKOUT_THRESHOLD=5
# LOCKOUT_DURATION_MINUTES=15

# The self-service password reset's email (D-137). Each value shown is the default, so none needs
# setting on the laptop.
# The address people open the platform at. A reset link is built from this alone, never from the
# request, so set it to the address users type when the platform is served anywhere else. It must
# be an absolute http:// or https:// address with no query: anything else stops the server starting.
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# The sender every email names.
# DEFAULT_FROM_EMAIL=no-reply@localhost
# Without EMAIL_HOST nothing is sent: each email is written as a file to EMAIL_FILE_PATH, by
# default outbox/ under the repository root, which is gitignored. A relative path resolves against
# the process working directory. Each file holds a working reset link, so keep the folder private.
# EMAIL_FILE_PATH=outbox
# Set EMAIL_HOST to send through an SMTP server instead. The rest of this block is read only then.
# EMAIL_HOST=
# EMAIL_PORT=587
# STARTTLS is the default, usually on port 587. For SSL from the first byte, usually on port 465,
# set EMAIL_USE_SSL=True and EMAIL_USE_TLS=False: both True stops the server starting.
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# The SMTP account, if the server needs one. The password belongs in .env only, never in a commit.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# How long to wait on the SMTP server, in seconds, before giving up on an email.
# EMAIL_TIMEOUT=30

# PostgreSQL 16 + pgvector from docker-compose.yml. Development credentials only.
DATABASE_URL=postgres://kmp:kmp@127.0.0.1:5432/kmp

# Where uploaded originals are stored (FR-08, docs/decisions.md D-05). Relative
# paths resolve against the process working directory; media/ under the repository
# root is the default and is gitignored. The extracted text is stored in the
# database, separately from the original.
MEDIA_ROOT=media

# --- AI provider (CLAUDE.md section 4, docs/ai-provider.md) ----------------
# anthropic Claude + Voyage. The default since D-122: needs the two API keys below, no NPU.
# flm       FastFlowLM on the local NPU. The offline alternative, v0.9.39 only (D-83).
# Choose once, before the first migrate: a database keeps the provider it was set up with, and its
# vector columns take that provider's width (docs/decisions.md D-131). Another provider means a new
# database.
AI_PROVIDER=anthropic

# Anthropic + Voyage, the default. Each key comes from its own console; never commit them.
# voyage-4 embeds at 1024 dimensions, the width a database set up for this provider has.
ANTHROPIC_API_KEY=
# Generation and FR-10 classification (D-121). claude-sonnet-5-5 is D-115's model.
ANTHROPIC_MODEL=claude-haiku-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# FastFlowLM, only read when AI_PROVIDER=flm. Start it in a second PowerShell window:
#   flm serve gemma3:4b --embed 1
FLM_BASE_URL=http://127.0.0.1:8625/v1
FLM_API_KEY=flm
FLM_CHAT_MODEL=gemma3:4b
FLM_EMBED_MODEL=embed-gemma

# Recording transcription (docs/decisions.md D-123): the meetings page turns a meeting
# recording into a draft transcript with Whisper on FLM. Independent of AI_PROVIDER, because only
# FLM has speech-to-text. none (the default) leaves it off; flm needs FLM started with --asr 1:
#   flm serve gemma3:4b --embed 1 --asr 1
TRANSCRIPTION_PROVIDER=none

# Where a meeting summary's run happens (FR-16, D-125). "thread", the default, runs it in a
# background thread of the server after the request has answered 202; the stack has no task queue.
# "inline" runs it in the caller's thread and is for the test suite. Leave it unset on a server.
# SUMMARY_RUNNER=thread
FLM_ASR_MODEL=whisper-v3:turbo

# EMBEDDING_DIMENSION is not set here: it follows AI_PROVIDER, 1024 for anthropic and 768 for flm
# (docs/decisions.md D-131). A line that disagrees with the provider stops the server (ai.E004).
